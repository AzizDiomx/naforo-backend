# =============================================================================
# BAILFLOW - Environment Configuration
# Copy this file to .env and fill in the values
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3001,http://localhost:3002

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://bailflow:bailflow_secret@localhost:5432/bailflow
DB_HOST=localhost
DB_PORT=5432
DB_NAME=bailflow
DB_USER=bailflow
DB_PASSWORD=bailflow_secret
DB_SSL=false
DB_POOL_MAX=10

# -----------------------------------------------------------------------------
# Cache (Redis)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# -----------------------------------------------------------------------------
# JWT Authentication
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET=your_super_secret_access_key_replace_with_64_chars_random_string_here_xx
JWT_REFRESH_SECRET=your_super_secret_refresh_key_replace_with_64_chars_random_string_here_xx
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
BCRYPT_ROUNDS=12

# -----------------------------------------------------------------------------
# Email (SMTP Hostinger - aziz.diomande@naforo.company et ses alias)
# -----------------------------------------------------------------------------
# -----------------------------------------------------------------------------
# Email (SMTP Principal - Hostinger)
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=aziz.diomande@naforo.company
SMTP_PASS=your_hostinger_email_password
SMTP_FROM_NAME=Naforo
SMTP_FROM_EMAIL=info@naforo.company
# Alias gérés automatiquement par service :
# - admin@naforo.company   -> Sécurité, abonnements, comptes super-admin, OTP
# - contact@naforo.company -> Commercial, bienvenue agences, inscriptions
# - support@naforo.company -> Assistance technique, pannes, incidents
# - info@naforo.company    -> Quittances, factures, avis d'échéance, paiements

# -----------------------------------------------------------------------------
# Email (SMTP Secours / Fallback - Google Gmail)
# Utilisé automatiquement si le serveur Hostinger ne répond pas
# -----------------------------------------------------------------------------
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587
GMAIL_SMTP_SECURE=false
GMAIL_USER=ismaeldiom70@gmail.com
GMAIL_PASS=your_google_app_password

# -----------------------------------------------------------------------------
# SMS (Twilio)
# -----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# -----------------------------------------------------------------------------
# Push Notifications (Firebase)
# -----------------------------------------------------------------------------
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com

# -----------------------------------------------------------------------------
# File Upload
# -----------------------------------------------------------------------------
UPLOAD_DIR=uploads
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp,application/pdf

# -----------------------------------------------------------------------------
# URLs
# -----------------------------------------------------------------------------
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001
BACKOFFICE_URL=http://localhost:3002

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=debug
LOG_DIR=logs

# -----------------------------------------------------------------------------
# Super Admin (Seed)
# -----------------------------------------------------------------------------
SUPER_ADMIN_EMAIL=admin@bailflow.ci
SUPER_ADMIN_PASSWORD=SuperAdmin@123!
